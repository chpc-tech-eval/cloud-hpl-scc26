---
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Student Project Platform</title>
  <style>
    body { font-family: system-ui, sans-serif; background:#0f172a; color:#e2e8f0; margin:0; display:grid; place-items:center; min-height:100vh; }
    main { background:#1e293b; padding:2rem; border-radius:12px; width:min(380px,90vw); }
    input, button { width:100%; padding:.6rem; margin:.3rem 0; border-radius:6px; border:1px solid #475569; box-sizing:border-box; }
    button { background:#3b82f6; color:white; border:0; cursor:pointer; }
    #msg { color:#fbbf24; min-height:1.2em; }
    summary { cursor:pointer; margin-top:1rem; }
  </style>
</head>
<body>
<main>
  <h1>Student Project Platform</h1>
  <p id="msg"></p>
  <form id="login">
    <input name="username" placeholder="Username" required />
    <input name="password" type="password" placeholder="Password" required />
    <button>Log in</button>
  </form>
  <details>
    <summary>Register</summary>
    <form id="register">
      <input name="username" placeholder="Username" required />
      <input name="displayName" placeholder="Display name" required />
      <input name="password" type="password" placeholder="Password (12+ chars)" required />
      <input name="code" type="password" placeholder="Team registration code" required />
      <button>Create account</button>
    </form>
  </details>
</main>
<script is:inline>
  const msg = document.getElementById('msg');
  async function post(path, form) {
    const body = Object.fromEntries(new FormData(form));
    const r = await fetch(path, { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
    return { ok: r.ok, data: await r.json().catch(() => ({})) };
  }
  document.getElementById('login').addEventListener('submit', async (e) => {
    e.preventDefault();
    const r = await post('/api/login', e.target);
    if (r.ok) location.href = '/dashboard/'; else msg.textContent = r.data.error || 'Login failed';
  });
  document.getElementById('register').addEventListener('submit', async (e) => {
    e.preventDefault();
    const r = await post('/api/register', e.target);
    msg.textContent = r.ok ? 'Account created (id ' + r.data.id + '). You can log in now.' : (r.data.error || 'Failed');
  });
  fetch('/api/me').then(r => { if (r.ok) location.href = '/dashboard/'; });
</script>
</body>
</html>